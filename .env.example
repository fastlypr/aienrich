# AI Enrich — local environment file.
# Copy this file to .env and fill in your real values.
# .env is gitignored, so secrets stay on your machine.

# === Required for the agent runner ============================================

# NVIDIA NIM API key — get one at https://build.nvidia.com (free tier works).
NVIDIA_API_KEY=nvapi-REPLACE_ME

# Apify API token — get one at https://console.apify.com.
# Leave blank or comment out to run the agent without Apify
# (it will still extract name/company/category but skip LinkedIn/Instagram).
APIFY_TOKEN=apify_api_REPLACE_ME

# Exa.ai API key — get one at https://exa.ai. Used by the Exa runner
# (enrich_urls_exa.py) for LinkedIn/website search. Leave blank to skip search.
EXA_API_KEY=exa_REPLACE_ME

# Extra search providers (used by the Telegram bot's waterfall / picker).
# All optional — leave blank to disable that provider.
BRAVE_API_KEY=
TAVILY_API_KEY=

# === Telegram bot (telegram_bot.py) =========================================

# Bot token from @BotFather.
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram user IDs allowed to use the bot.
# (Message the bot once; it replies with your ID if this is empty.)
TELEGRAM_ALLOWED_USERS=

# === Optional ================================================================

# Override the NVIDIA model. Default is meta/llama-3.1-70b-instruct.
# NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# === Existing config (also accepted, but normally lives in .aienrich_config.json) ===

# NOTION_TOKEN=ntn_...
# NOTION_DB_ID=...
# AIENRICH_SHEET_URL=https://docs.google.com/spreadsheets/d/.../edit
